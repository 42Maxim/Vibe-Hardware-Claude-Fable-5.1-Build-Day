// =============================================================================
// Puck — secrets.h.example
//
// Copy to firmware/secrets.h and fill in. secrets.h is NOT committed.
// Only companion.ino reads it, and only when CLAUDE_WIFI_ENABLED is 1.
//
// Why this is not in config.h: build.py parses config.h with
//     #define ([A-Z0-9_]+) +([-0-9.]+)
// and exports every match to the browser demo as FW.NAME. A quoted string does
// not match, so it would be silently dropped — and a Wi-Fi password has no
// business being compiled into a public HTML file anyway.
// =============================================================================
#ifndef PUCK_SECRETS_H
#define PUCK_SECRETS_H

#define WIFI_SSID "your-2G4-network"   // the ESP32-S3 has no 5 GHz radio
#define WIFI_PASS "your-password"

#endif // PUCK_SECRETS_H
